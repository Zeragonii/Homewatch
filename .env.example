ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
SESSION_SECRET=replace-with-a-long-random-value
DATABASE_URL=postgresql+psycopg://homewatch:homewatch@db:5432/homewatch
SCREENSHOT_DIR=/data/screenshots
APP_TITLE=HomeWatch

# GitHub repo used for automatic agent updates. Public repos need no token.
AGENT_RELEASE_REPO=Zeragonii/Homewatch
# GITHUB_TOKEN=github_pat_xxx  # Optional: only needed if the repo/releases are private.

# IANA timezone used for screen-time schedules and day boundaries
FAMILY_TIMEZONE=Europe/London
