<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HomeWatchAgent</AssemblyName>
    <Version>0.5.9.3</Version>
    <ApplicationIcon>HomeWatch.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Bundled inside HomeWatchAgent.exe; does not change the three-binary updater archive. -->
    <EmbeddedResource Include="..\..\tools\Manage-DefenderExclusions.ps1" LogicalName="HomeWatch.Manage-DefenderExclusions.ps1" />
  </ItemGroup>
</Project>
